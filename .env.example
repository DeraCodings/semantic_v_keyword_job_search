SERPAPI_API_KEY=your_serpapi_key_here
FIRECRAWL_API_KEY=your_firecrawl_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# OpenRouter Settings (Defaulting to cheap/free reliable inference)
OPENROUTER_MODEL=deepseek/deepseek-r1-distill-llama-70b:free

# JINA EMBEDDING API
JINA_API_KEY=your_jina_api_key_here
JINA_EMBEDDING_MODEL=jina-embeddings-v5-omni-small

# PostgreSQL Connection URL
DATABASE_URL=your_postgresql_connection_url_here